rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() {return request.auth != null;}
  function google() {return signed() && request.auth.token.firebase.sign_in_provider == 'google.com';}
  function parent(family) {return google() && request.auth.uid == family;}
  // Missing metadata means an existing active profile and its original device generation.
  function activeData(d) {return d.get('archived',false) == false && d.get('deleting',false) == false;}
  function deletingProfile(family,child) {
   return exists(/databases/$(database)/documents/families/$(family)/children/$(child)) &&
    get(/databases/$(database)/documents/families/$(family)/children/$(child)).data.get('deleting',false) == true;
  }
  function generation(d) {return d.get('accessVersion',0);}
  function activeProfile(family,child) {
   return exists(/databases/$(database)/documents/families/$(family)/children/$(child)) &&
    activeData(get(/databases/$(database)/documents/families/$(family)/children/$(child)).data);
  }
  function activeAfter(family,child) {
   return activeData(getAfter(/databases/$(database)/documents/families/$(family)/children/$(child)).data);
  }
  function ownChild(family, child) {
   return signed() && exists(/databases/$(database)/documents/devices/$(request.auth.uid)) &&
    get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.family == family &&
    get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.child == child && activeProfile(family,child) &&
    generation(get(/databases/$(database)/documents/devices/$(request.auth.uid)).data) ==
     generation(get(/databases/$(database)/documents/families/$(family)/children/$(child)).data);
  }
  function validMetadata(d) {
   return d.name is string && d.name.size()>0 && d.name.size()<=40 && d.get('archived',false) is bool && d.get('deleting',false) is bool &&
    generation(d) is int && generation(d)>=0 && generation(d)<2147483647;
  }
  function parentUpdate(old,next) {
   return validMetadata(next) && !old.get('deleting',false) &&
    ((next.get('deleting',false) == true && next.get('archived',false) == true &&
      generation(next) == generation(old)+1 && next.diff(old).affectedKeys().hasOnly(['deleting','archived','accessVersion'])) ||
     (next.get('deleting',false) == false &&
      generation(next) == generation(old) + ((activeData(old) && !activeData(next)) ? 1 : 0) &&
      ((activeData(old) && activeData(next)) || next.diff(old).affectedKeys().hasOnly(['name','archived','accessVersion']))));
  }
  function known(id) {
   return id.matches('m1-r(00[1-9]|0[1-8][0-9]|090)|m2-r(09[1-9]|1[0-7][0-9]|18[0-7])|m3-r(18[8-9]|19[0-9]|2[0-7][0-9]|28[0-2])|m4-r(28[3-9]|29[0-9]|3[0-8][0-9])|m5-r(39[0-9]|4[0-7][0-9]|48[0-7])|m6-r(48[8-9]|49[0-9]|5[0-8][0-9])|m7-r(59[0-9]|6[0-7][0-9]|68[0-8])|m8-r(689|69[0-9]|7[0-6][0-9]|77[0-1])|m9-r(77[2-9]|7[8-9][0-9]|8[0-1][0-9]|82[0-9])');
  }
  function oneAdded(old, next) {
   return old is list && next is list && next.size() == old.size()+1 && next.size() <= 829 &&
    next.toSet().size() == next.size() && next.hasAll(old) && known(next[next.size()-1]) && !(next[next.size()-1] in old);
  }
  function childWallet(old, next) {
   return next.keys().hasOnly(['version','words','sentences','exchanges']) && next.version == 1 && next.exchanges == old.exchanges &&
    ((next.sentences == old.sentences && oneAdded(old.words, next.words)) ||
     (next.words == old.words && oneAdded(old.sentences, next.sentences)) || next == old);
  }
  match /devices/{uid} {
   allow get: if signed() && (request.auth.uid == uid || (google() && (resource.data.family == '' || resource.data.family == request.auth.uid)));
   allow list: if google() && resource.data.family == request.auth.uid;
   allow create: if signed() && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'anonymous' &&
    request.resource.data.keys().hasOnly(['family','child']) && request.resource.data.family == '' && request.resource.data.child == '';
   allow update: if google() && (resource.data.family == '' || resource.data.family == request.auth.uid) &&
    request.resource.data.keys().hasOnly(['family','child','accessVersion']) && generation(request.resource.data) is int && generation(request.resource.data)>=0 &&
    ((request.resource.data.family == '' && request.resource.data.child == '' && resource.data.family == request.auth.uid) ||
     (request.resource.data.family == request.auth.uid && request.resource.data.child is string &&
      (resource.data.family == '' || resource.data.child == request.resource.data.child) &&
      activeAfter(request.auth.uid,request.resource.data.child) &&
      generation(request.resource.data) == generation(getAfter(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(request.resource.data.child)).data)));
   allow delete: if false;
  }
  match /families/{family}/children/{child} {
   allow read: if parent(family) || ownChild(family,child);
   allow create: if parent(family) && validMetadata(request.resource.data) && activeData(request.resource.data) && generation(request.resource.data)==0 &&
    request.resource.data.wallet == {'version':1,'words':[],'sentences':[],'exchanges':[]} && request.resource.data.activity == false;
   allow update: if (parent(family) && parentUpdate(resource.data,request.resource.data)) || (ownChild(family,child) && activeAfter(family,child) &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wallet','activity']) && request.resource.data.activity == true &&
    childWallet(resource.data.wallet,request.resource.data.wallet));
   allow delete: if parent(family) && resource.data.get('deleting',false) == true;
   // Oral plans and grades are parent-only; the child receives a separate current prompt.
   match /checks/{session} {
    allow read: if parent(family);
    allow create, update: if parent(family) && activeProfile(family,child) && activeAfter(family,child);
    allow delete: if parent(family) && deletingProfile(family,child);
   }
   match /checkLive/{slot} {
    allow read: if parent(family) || (slot == 'current' && ownChild(family,child));
    allow create: if slot == 'current' && parent(family) && activeProfile(family,child) && activeAfter(family,child);
    allow update: if slot == 'current' && activeProfile(family,child) && activeAfter(family,child) &&
     (parent(family) || (ownChild(family,child) && resource.data.status == 'waiting' && resource.data.ready == false &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready']) && request.resource.data.ready == true));
    allow delete: if parent(family) && deletingProfile(family,child);
   }
   match /exchanges/{index} {
    allow read: if parent(family) || ownChild(family,child);
    allow create: if parent(family) && activeProfile(family,child) && activeAfter(family,child);
    allow update: if false;
    allow delete: if parent(family) && deletingProfile(family,child);
   }
   match /results/{lesson} {
    function score(s,total) {
     return s is map && s.firstTryCorrect is int && s.firstTryCorrect>=0 && s.firstTryCorrect<=total &&
      s.errors is int && s.errors>=total-s.firstTryCorrect && s.total==total;
    }
    function improved(old,next) {return next.firstTryCorrect>old.firstTryCorrect || (next.firstTryCorrect==old.firstTryCorrect && next.errors<=old.errors);}
    function lessonSize(id) {return {"m1-l1":20,"m1-l2":20,"m1-l3":20,"m1-l4":20,"m1-l5":20,"m1-l6":20,"m1-l7":20,"m1-l8":20,"m1-l9":20,"m2-l1":20,"m2-l2":20,"m2-l3":20,"m2-l4":20,"m2-l5":20,"m2-l6":20,"m2-l7":20,"m2-l8":18,"m2-l9":18,"m2-l10":18,"m3-l1":20,"m3-l2":20,"m3-l3":20,"m3-l4":20,"m3-l5":20,"m3-l6":18,"m3-l7":18,"m3-l8":18,"m3-l9":18,"m3-l10":18,"m4-l1":20,"m4-l2":20,"m4-l3":20,"m4-l4":20,"m4-l5":20,"m4-l6":20,"m4-l7":20,"m4-l8":20,"m4-l9":18,"m4-l10":18,"m4-l11":18,"m5-l1":20,"m5-l2":20,"m5-l3":20,"m5-l4":20,"m5-l5":20,"m5-l6":20,"m5-l7":20,"m5-l8":20,"m5-l9":18,"m5-l10":18,"m6-l1":20,"m6-l2":20,"m6-l3":20,"m6-l4":18,"m6-l5":18,"m6-l6":18,"m6-l7":18,"m6-l8":18,"m6-l9":18,"m6-l10":18,"m6-l11":18,"m7-l1":20,"m7-l2":20,"m7-l3":20,"m7-l4":20,"m7-l5":20,"m7-l6":20,"m7-l7":20,"m7-l8":20,"m7-l9":20,"m7-l10":18,"m8-l1":20,"m8-l2":20,"m8-l3":18,"m8-l4":18,"m8-l5":18,"m8-l6":18,"m8-l7":18,"m8-l8":18,"m8-l9":18,"m9-l1":20,"m9-l2":20,"m9-l3":20,"m9-l4":20,"m9-l5":18,"m9-l6":18}[id];}
    function validResult() {
     let d=request.resource.data;
     let total=lessonSize(lesson);
     return d.keys().hasOnly(['signature','cards','sentences','legacySentences']) && d.signature is string && d.signature.size()<2000 &&
      (!('cards' in d) || d.cards==null || score(d.cards,total)) &&
      (!('sentences' in d) || d.sentences==null || (score(d.sentences,total) && d.sentences.format==2 &&
       d.sentences.englishFirstTry is int && d.sentences.englishFirstTry>=0 && d.sentences.englishFirstTry<=(total / 2) &&
       d.sentences.translationFirstTry is int && d.sentences.translationFirstTry>=0 && d.sentences.translationFirstTry<=(total / 2) &&
       d.sentences.englishFirstTry+d.sentences.translationFirstTry==d.sentences.firstTryCorrect)) &&
      (!('legacySentences' in d) || d.legacySentences==null || score(d.legacySentences,(total / 2)));
    }
    allow read: if parent(family) || ownChild(family,child);
    allow create: if (parent(family) || ownChild(family,child)) && activeProfile(family,child) && activeAfter(family,child) && getAfter(/databases/$(database)/documents/families/$(family)/children/$(child)).data.activity == true && validResult();
    allow update: if (parent(family) || ownChild(family,child)) && activeProfile(family,child) && activeAfter(family,child) && validResult() &&
     (!('cards' in resource.data) || resource.data.cards==null || (request.resource.data.cards!=null && improved(resource.data.cards,request.resource.data.cards))) &&
     (!('sentences' in resource.data) || resource.data.sentences==null || (request.resource.data.sentences!=null && improved(resource.data.sentences,request.resource.data.sentences)));
    allow delete: if parent(family) && deletingProfile(family,child);
   }
  }
  match /families/{family}/imports/{hash} {
   allow read: if parent(family);
   allow create: if parent(family) && request.resource.data.keys().hasOnly(['child','createdAt']) &&
    request.resource.data.child is string && activeProfile(family,request.resource.data.child) && activeAfter(family,request.resource.data.child);
   // Retain only the opaque fingerprint, without a child identifier or other personal fields.
   allow update: if parent(family) && resource.data.get('child','') is string &&
    deletingProfile(family,resource.data.get('child','')) && request.resource.data == {'used':true};
   allow delete: if false;
  }
 }
}
